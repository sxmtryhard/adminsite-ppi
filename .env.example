# Configuración web de Firebase (Consola > Configuración del proyecto > Tus apps).
# Estos valores identifican el proyecto; la seguridad la aplican firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Solo servidor (Vercel → Environment Variables). Ver docs/CORREO.md ---
# FIREBASE_SERVICE_ACCOUNT=   JSON de la cuenta de servicio (nunca con prefijo VITE_)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# APP_URL=https://adminsite-ppi.vercel.app
# CRON_SECRET=
# STUDIO_NAME=XAC Barber Studio
